VERIFY_TOKEN=your_verify_token_here
META_APP_SECRET=your_meta_app_secret_here
PAGE_TOKEN=your_page_access_token_here
BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_KEY=patXXXXXXXXXXXXXX

# Graph çağrısı (örn. v21.0). Boşsa v21.0 kullanılır.
GRAPH_API_VERSION=v21.0

# CSV ile aynı: ham webhook + Graph cevabı (Long text). Varsayılan: Raw Payload
AIRTABLE_RAW_PAYLOAD_FIELD=Raw Payload

# Source sütunu (varsayılan: Meta Lead Ads Webhook)
LEAD_SOURCE_LABEL=Meta Lead Ads Webhook

# Airtable 422 önleme (varsayılanlar güvenli):
# Received At formül alanıysa yazma; yazmak için true
AIRTABLE_WRITE_RECEIVED_AT=false
# Graph başarısızken "Sync Status" = Partial yazmak (tabloda seçenek varsa true)
AIRTABLE_WRITE_SYNC_STATUS_ON_FAILURE=false
# Graph başarısızken "Error Message" doldurmak
AIRTABLE_WRITE_ERROR_MESSAGE_ON_FAILURE=false
# Source sütunu single-select uyumsuzsa false
# AIRTABLE_WRITE_SOURCE=false
# Graph başarılı satırda Sync Status / Received At (varsayılan Sync açık, Received kapalı)
# AIRTABLE_WRITE_SYNC_STATUS=false
# Sadece Leadgen ID + Raw Payload (422 debug)
# AIRTABLE_PARTIAL_MINIMAL=true
# Single select seçenek metinleri tabloyla birebir
# AIRTABLE_SYNC_STATUS_SYNCED=Synced
# AIRTABLE_SYNC_STATUS_PARTIAL=Partial
